-- Progressive radiation damage aligned with EGUI's accumulated-radiation states.
-- The first (grey) EGUI state is warning-only; yellow, orange and red deal damage.

local MCM_ID = "sep_progressive_radiation_damage"
local TICK_INTERVAL_MS = 1000

local DEFAULT_DAMAGE_PERCENT = {
	[1] = 0.15,
	[2] = 0.60,
	[3] = 2.00,
}

local next_damage_tick = 0

local function option_value(key, default)
	if ui_mcm then
		local value = ui_mcm.get(MCM_ID .. "/" .. key)
		if value ~= nil then
			return value
		end
	end
	return default
end

local function is_enabled()
	local value = option_value("enabled", true)
	return value ~= false and value ~= 0
end

-- EGUI uses math.ceil(db.actor.radiation * 4):
-- 1 = grey (0..0.25], 2 = yellow (0.25..0.50],
-- 3 = orange (0.50..0.75], 4 = red (0.75..1.00].
local function damage_tier(radiation)
	if radiation > 0.75 then
		return 3
	elseif radiation > 0.50 then
		return 2
	elseif radiation > 0.25 then
		return 1
	end
	return 0
end

local function damage_for_tier(tier)
	local default = DEFAULT_DAMAGE_PERCENT[tier] or 0
	local percent = tonumber(option_value("tier_" .. tier .. "_damage", default)) or default
	return math.max(percent, 0) / 100
end

local function actor_on_update()
	local actor = db.actor
	if not actor or not actor:alive() then
		return
	end

	local now = time_global()
	if now < next_damage_tick then
		return
	end
	next_damage_tick = now + TICK_INTERVAL_MS

	if not is_enabled() then
		return
	end

	local tier = damage_tier(actor.radiation or 0)
	if tier == 0 then
		return
	end

	local damage = damage_for_tier(tier)
	if damage <= 0 then
		return
	end

	actor:set_health_ex(math.max((actor.health or 0) - damage, 0))
end

function on_game_start()
	next_damage_tick = time_global() + TICK_INTERVAL_MS
	RegisterScriptCallback("actor_on_update", actor_on_update)
end

function on_mcm_load()
	return {
		id = MCM_ID,
		sh = true,
		gr = {
			{id = "title", type = "title", text = "ui_mcm_sep_progressive_radiation_damage_title"},
			{id = "description", type = "desc", text = "ui_mcm_sep_progressive_radiation_damage_description"},
			{id = "enabled", type = "check", val = 1, def = true},
			{id = "tier_1_damage", type = "track", val = 2, def = DEFAULT_DAMAGE_PERCENT[1], min = 0, max = 2, step = 0.05},
			{id = "tier_2_damage", type = "track", val = 2, def = DEFAULT_DAMAGE_PERCENT[2], min = 0, max = 4, step = 0.05},
			{id = "tier_3_damage", type = "track", val = 2, def = DEFAULT_DAMAGE_PERCENT[3], min = 0, max = 8, step = 0.10},
			{id = "rates_hint", type = "desc", text = "ui_mcm_sep_progressive_radiation_damage_rates_hint"},
		},
	}
end
